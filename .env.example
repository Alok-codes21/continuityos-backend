
# Copy this file to .env and set your own secrets.
# Never commit .env.

FLASK_APP=run.py
FLASK_DEBUG=true

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
JWT_SECRET=change-me-to-a-long-random-string

# Local development database
DATABASE_URL=sqlite:///continuityos.db

# Optional encryption key
TOKEN_ENCRYPTION_KEY=

# Frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Knowledge freshness
OUTDATED_DAYS=180

# Optional LLM integration. Keep "none" for rule-based behaviour.
LLM_PROVIDER=none
LLM_API_KEY=
